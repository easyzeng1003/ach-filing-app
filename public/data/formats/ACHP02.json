        "validation": {
          "rules": [
            {
              "type": "required",
              "message": "日期長度請輸入八碼"
            },
            {
              "type": "exactLength",
              "length": 8,
              "message": "日期長度請輸入八碼"
            },
            {
              "type": "rocDate",

{
  "code": "ACHP02",
  "shortCode": "P02",
  "name": "授權建檔檔",
  "description": "產生 ACH 授權扣款建檔上傳檔（V10），支援 A/D/O/M",
  "version": "V10",
  "recordLength": 220,
  "lineEnding": "\r\n",
  "filenamePattern": "{code}_{date}{txid}{taxId}.txt",
  "features": {
    "sumAmount": false,
    "amountKey": null,
    "authOptions": true,
    "detailFilter": true,
    "exportFormats": [
      "txt",
      "html",
      "js"
    ]
  },
  "authOptions": [
    {
      "value": "A",
      "label": "A：新增",
      "note": "「A：新增」– 新增收受者授權扣款資料。",
      "desc": "A 檔「發動行新增授權扣款」"
    },
    {
      "value": "D",
      "label": "D：取消",
      "note": "「D：取消」– 取消收受者原有授權的扣款資料。",
      "desc": "D 檔「發動行取消授權扣款」"
    },
    {
      "value": "O",
      "label": "O：舊戶轉換",
      "note": "「O：舊戶轉換」– 轉換舊有已簽約委繳戶的授權扣款資料。",
      "desc": "O 檔「發動行新增舊有已簽約委繳戶資料」"
    },
    {
      "value": "M",
      "label": "M：異動扣款限額及終止日",
      "note": "「M：異動扣款限額及終止日」– 調整委繳戶的扣款限額或扣款終止日。",
      "desc": "M 檔「發動行新增或異動扣款限額及扣款終止日」"
    }
  ],
  "form": {
